import java.util.Scanner;

public class NotasLetras {
    static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int nota;

        System.out.println("Dame la nota de tu ultimo examen");

        System.out.print("NOTA: ");
        nota = sc.nextInt();

        if (nota <= 4) {
            System.out.println("Sacastes un " + nota + ", estas suspenso...");
        }
        if (nota == 5) {
            System.out.println("Sacastes un " + nota + ", tienes un suficiente");
        }
        if (nota == 6) {
            System.out.println("Sacastes un " + nota + ", tienes un bien");
        }
        if (nota == 7 || nota == 8) {
                System.out.println("Sacastes un " + nota + ", muy bien, tienes un notable");
        }
        if (nota == 9) {
            System.out.println("Sacastes un " + nota + ", muy buena nota, tienes un sobresaliente!");
        }
        if (nota == 10) {
            System.out.println("Sacastes un " + nota + ", enhorabuena! Tienes una matricula de honor");
        }
        if (nota > 10) {
            System.out.println("No te flipes, no puntuamos por encima del 10");
        }
    }
}
